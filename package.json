{
  "name": "@hypercerts/hypercerts-feed-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:empty": "changeset --empty",
    "changeset:status": "changeset status",
    "codegen": "node scripts/codegen.mjs",
    "prebuild": "npm run codegen",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-sql.mjs && node scripts/check-build.mjs",
    "dev": "tsx watch --include src/feed/feed-query.sql src/server.ts",
    "pretest": "npm run codegen",
    "test": "vitest run test/*.unit.test.ts",
    "pretest:unit": "npm run codegen",
    "test:unit": "vitest run test/*.unit.test.ts",
    "pretest:integration": "npm run codegen",
    "test:integration": "vitest run test/*.integration.test.ts",
    "test:integration:happyview": "sh scripts/test-happyview-schema.sh && npm run test:integration",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "precheck": "npm run codegen",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "^0.3.7",
    "@atproto-labs/fetch-node": "^0.3.7",
    "@atproto/lex": "^0.3.8",
    "@atproto/lex-server": "^0.1.19",
    "@atproto/lexicon": "0.6.2",
    "@atproto/syntax": "^0.7.2",
    "@hypercerts-org/lexicon": "1.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@atproto/crypto": "^0.5.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
