meta {
  name: Feed - observations only
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/xrpc/app.gainforest.feed.getFeed
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}",
      "filter": "observation"
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}
