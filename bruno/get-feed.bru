meta {
  name: Feed (references and metadata)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/xrpc/app.gainforest.feed.getFeed
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}"
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}
