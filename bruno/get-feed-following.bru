meta {
  name: Feed - following (all parameters)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/xrpc/app.gainforest.feed.getFeed
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}",
      "filter": "all",
      "following": true,
      "viewerDid": "{{viewerDid}}"
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}
