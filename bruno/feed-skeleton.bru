meta {
  name: Feed skeleton
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/xrpc/app.gainforest.feed.getFeedSkeleton
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}"
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}
